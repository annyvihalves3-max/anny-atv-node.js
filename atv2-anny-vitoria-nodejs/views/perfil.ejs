<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<div class="container my-5">
    <div class="row">

        <aside class="col-md-3">
            <div class="perfil-sidebar p-3 border rounded shadow-sm bg-white">
                <div class="text-center mb-4">
                    <div class="avatar-placeholder mb-2 mx-auto">
                        <i class="fa-solid fa-user fa-2x text-muted"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Lucas Martins</h6>
                    <small class="text-orange">Explorador Bronze</small>
                </div>

                <div class="list-group list-group-flush">
                    <a href="/perfil" class="list-group-item list-group-item-action border-0 d-flex align-items-center"
                       onclick="showTab('painel')">
                        <i class="fa-solid fa-border-all me-3"></i> Meu Painel
                    </a>
                    <a href="#" class="list-group-item list-group-item-action border-0 d-flex align-items-center"
                       onclick="showTab('dados')">
                        <i class="fa-regular fa-user me-3"></i> Meus Dados
                    </a>
                    <a href="#" class="list-group-item list-group-item-action border-0 d-flex align-items-center"
                       onclick="showTab('roteiros')">
                        <i class="fa-regular fa-bookmark me-3"></i> Meus Roteiros Salvos
                    </a>
                    <a href="#" class="list-group-item list-group-item-action border-0 d-flex align-items-center"
                       onclick="showTab('viagens')">
                        <i class="fa-solid fa-route me-3"></i> Minhas Viagens
                    </a>
                    <a href="/cadastrarViagens" class="list-group-item list-group-item-action border-0 d-flex align-items-center">
                        <i class="fa-solid fa-plus me-3"></i> Cadastrar Viagem
                    </a>
                    <hr>
                    <a href="/" class="list-group-item list-group-item-action border-0 d-flex align-items-center text-danger">
                        <i class="fa-solid fa-arrow-right-from-bracket me-3"></i> Sair
                    </a>
                </div>
            </div>
        </aside>

    
        <main class="col-md-9">

            <div id="tab-roteiros">

                <div class="d-flex align-items-center mb-1">
                    <h4 class="fw-bold mb-0">Meus Roteiros Salvos</h4>
                    <i class="fa-solid fa-star text-orange ms-2"></i>
                </div>
                <p class="text-muted small mb-4">Explore e organize seus destinos favoritos</p>

                <div class="row g-4">
                    <% roteiros.forEach(function(item) { %>
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm profile-card">
                                <div class="position-relative">
                                    <img src="<%= item.img %>" class="card-img-top" alt="<%= item.nome %>">
                                    <div class="bookmark-badge">
                                        <i class="fa-regular fa-bookmark"></i>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h6 class="fw-bold mb-1"><%= item.nome %></h6>
                                    <p class="text-muted small mb-3"><%= item.descricao %></p>
                                    <div class="col-6">
                                        <a href="#" class="btn btn-outline-danger btn-sm w-100">Ver Detalhes</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="mt-5">
                    <div class="d-flex align-items-center mb-1">
                        <h4 class="fw-bold mb-0">Minhas Viagens</h4>
                        <i class="fa-solid fa-route text-danger ms-2"></i>
                    </div>
                    <p class="text-muted small mb-4">Destinos que você cadastrou</p>

                    <% if (viagens.length === 0) { %>
                        <div class="text-center text-muted py-4">
                            <i class="fa-solid fa-map-location-dot fa-2x mb-2 text-danger opacity-50"></i>
                            <p class="fw-semibold mb-0">Você ainda não cadastrou nenhuma viagem.</p>
                        </div>
                    <% } else { %>
                        <div class="row g-4">
                            <% viagens.forEach(function(v) { %>
                                <div class="col-md-6">
                                    <div class="card h-100 border-0 shadow-sm profile-card">
                                        <% if (v.imagem) { %>
                                            <img src="<%= v.imagem %>" class="card-img-top" alt="<%= v.nome %>" style="height:180px; object-fit:cover;">
                                        <% } else { %>
                                            <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px;">
                                                <i class="fa-solid fa-image fa-2x text-muted"></i>
                                            </div>
                                        <% } %>
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <h6 class="fw-bold mb-0"><%= v.nome %></h6>
                                                <span class="badge bg-danger-subtle text-danger rounded-pill" style="font-size:0.7rem;">
                                                    <%= v.tipo %>
                                                </span>
                                            </div>
                                            <p class="text-muted small mb-1">
                                                <i class="fa-solid fa-location-dot me-1"></i>
                                                <%= v.cidade %><%= v.estado ? ', ' + v.estado : '' %><%= v.pais ? ', ' + v.pais : '' %>
                                            </p>
                                            <p class="text-muted small mb-2"><%= v.descricao %></p>
                                            <div class="text-warning mb-3">
                                                <% for(let i = 1; i <= 5; i++) { %>
                                                    <%= i <= v.avaliacao ? '★' : '☆' %>
                                                <% } %>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <a href="/editarViagem/<%= v.id %>" class="btn btn-outline-danger btn-sm w-50">
                                                    <i class="fa-solid fa-pen me-1"></i> Editar
                                                </a>
                                                <form action="/excluirViagem/<%= v.id %>" method="POST" style="width:50%">
                                                    <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                                        <i class="fa-solid fa-trash me-1"></i> Excluir
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <div class="mt-4 text-center">
                    <a href="/cadastrarViagens" class="btn btn-danger fw-semibold px-4">
                        <i class="fa-solid fa-plus me-2"></i> Cadastrar Nova Viagem
                    </a>
                </div>
            </div>

            <div id="tab-viagens" class="d-none">
                <div class="d-flex align-items-center mb-1">
                    <h4 class="fw-bold mb-0">Minhas Viagens</h4>
                    <i class="fa-solid fa-route text-danger ms-2"></i>
                </div>
                <p class="text-muted small mb-4">Destinos que você cadastrou</p>

                <% if (viagens.length === 0) { %>
                    <div class="text-center text-muted py-5">
                        <i class="fa-solid fa-map-location-dot fa-3x mb-3 text-danger opacity-50"></i>
                        <p class="fw-semibold">Você ainda não cadastrou nenhuma viagem.</p>
                        <a href="/cadastrarViagens" class="btn btn-danger px-4">
                            <i class="fa-solid fa-plus me-2"></i> Cadastrar agora
                        </a>
                    </div>
                <% } else { %>
                    <div class="row g-4">
                        <% viagens.forEach(function(v) { %>
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm profile-card">
                                    <% if (v.imagem) { %>
                                        <img src="<%= v.imagem %>" class="card-img-top" alt="<%= v.nome %>" style="height:180px; object-fit:cover;">
                                    <% } else { %>
                                        <div class="bg-light d-flex align-items-center justify-content-center" style="height:180px;">
                                            <i class="fa-solid fa-image fa-2x text-muted"></i>
                                        </div>
                                    <% } %>
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <h6 class="fw-bold mb-0"><%= v.nome %></h6>
                                            <span class="badge bg-danger-subtle text-danger rounded-pill" style="font-size:0.7rem;">
                                                <%= v.tipo %>
                                            </span>
                                        </div>
                                        <p class="text-muted small mb-1">
                                            <i class="fa-solid fa-location-dot me-1"></i>
                                            <%= v.cidade %><%= v.estado ? ', ' + v.estado : '' %><%= v.pais ? ', ' + v.pais : '' %>
                                        </p>
                                        <p class="text-muted small mb-2"><%= v.descricao %></p>
                                        <div class="text-warning mb-3">
                                            <% for(let i = 1; i <= 5; i++) { %>
                                                <%= i <= v.avaliacao ? '★' : '☆' %>
                                            <% } %>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a href="/editarViagem/<%= v.id %>" class="btn btn-outline-danger btn-sm w-50">
                                                <i class="fa-solid fa-pen me-1"></i> Editar
                                            </a>
                                            <form action="/excluirViagem/<%= v.id %>" method="POST" style="width:50%">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                                                    <i class="fa-solid fa-trash me-1"></i> Excluir
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="mt-4 text-center">
                        <a href="/cadastrarViagens" class="btn btn-danger fw-semibold px-4">
                            <i class="fa-solid fa-plus me-2"></i> Cadastrar Nova Viagem
                        </a>
                    </div>
                <% } %>
            </div>

        </main>
    </div>
</div>

<%- include ('partials/footer.ejs') %>

<script>
    function showTab(tab) {
        document.querySelectorAll('main > div[id^="tab-"]').forEach(el => el.classList.add('d-none'));
        document.getElementById('tab-' + tab).classList.remove('d-none');
    }
    showTab('roteiros');
</script>