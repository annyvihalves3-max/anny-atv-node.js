<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<main style="min-height: 100vh;">
<section class="hero">
    <div class="hero-container">
        <h1>Descubra o Mundo Autêntico.</h1>
        <p>Explore trilhas, cachoeiras e vilas charmosas fora do óbvio.</p>
    </div>
</section>

<section class="container my-5">
    <div class="cabecalho-destinos">
        <h2 class="fw-bold">Destinos em Destaque do Brasil</h2>
        <a href="/nacional" class="ver-mais-link">Ver mais</a>
    </div>
    
    <div class="row g-4">

        <div class="col-md-3">
            <div class="card destino-card h-100">
                <img src="../imgs/rio-janeiro.jpg" class="card-img" alt="Rio de Janeiro">
                <div class="card-body">
                    <h5 class="card-titulo">Rio de Janeiro (RJ)</h5>
                    <p class="card-text">A Cidade Maravilhosa: do Cristo Redentor às trilhas do Morro da Urca.</p>
                    <div class="estrelas">★★★★★</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card destino-card h-100">
                <img src="../imgs/fernando-de-noronha.jpg" class="card-img" alt="Fernando de Noronha">
                <div class="card-body">
                    <h5 class="card-titulo">Fernando de Noronha (PE)</h5>
                    <p class="card-text">Mergulho em águas cristalinas e as praias mais bonitas do mundo.</p>
                    <div class="estrelas">★★★★★</div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card destino-card h-100">
                <img src="../imgs/bonito.jpg" class="card-img" alt="Bonito">
                <div class="card-body">
                    <h5 class="card-titulo">Bonito (MS)</h5>
                    <p class="card-text">Flutuação em rios transparentes e cavernas com lagos azuis profundos.</p>
                    <div class="estrelas">★★★★★</div>
                </div>
            </div>
        </div>

          <div class="col-md-3">
            <div class="card destino-card h-100">
                <img src="../imgs/paraty.jpg" class="card-img" alt="Paraty">
                <div class="card-body">
                    <h5 class="card-titulo">Paraty (RJ)</h5>
                    <p class="card-text">Casarões coloniais, barcos coloridos e o encontro da serra com o mar.</p>
                    <div class="estrelas">★★★★★</div>
                </div>
            </div>
        </div>

    </div>
</section>

<section class="container my-5">
    <div class="cabecalho-destinos">
        <h2 class="fw-bold">Destinos em Destaque Internacional</h2>
        <a href="/internacional" class="ver-mais-link">Ver mais</a>
    </div>
    
    <div class="row g-4">

        <div class="col-md-3">
            <div class="card destino-card h-100">
                <img src="../imgs/paris.webp" class="card-img" alt="Paris">
                <div class="card-body">
                    <h5 class="card-titulo">Paris (FR)</h5>
                    <p class="card-text">A Cidade Luz: arte no Louvre, charmes da Torre Eiffel e cafés em Montmartre.

</p>
                    <div class="estrelas">★★★★★</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card destino-card h-100">
                <img src="../imgs/barcelona.jpg" class="card-img" alt="Barcelona">
                <div class="card-body">
                    <h5 class="card-titulo">Barcelona (ES)</h5>
                    <p class="card-text">A arquitetura de Gaudí, as ruelas do Bairro Gótico e a energia da Barceloneta.</p>
                    <div class="estrelas">★★★★★</div>
                </div>
            </div>
        </div>
        
        <div class="col-md-3">
            <div class="card destino-card h-100">
                <img src="../imgs/nova-york.jpg" class="card-img" alt="Nova York">
                <div class="card-body">
                    <h5 class="card-titulo">Nova York (EUA) </h5>
                    <p class="card-text">A energia da Times Square, o Central Park e os espetáculos da Broadway.</p>
                    <div class="estrelas">★★★★★</div>
                </div>
            </div>
        </div>

          <div class="col-md-3">
            <div class="card destino-card h-100">
                <img src="../imgs/japao.jpg" class="card-img" alt="Japão">
                <div class="card-body">
                    <h5 class="card-titulo">Japão (JP)</h5>
                    <p class="card-text">O contraste perfeito entre templos milenares e o futurismo de Shibuya.</p>
                    <div class="estrelas">★★★★★</div>
                </div>
            </div>
        </div>

    </div>
</section>

<%- include ('partials/footer.ejs') %>


