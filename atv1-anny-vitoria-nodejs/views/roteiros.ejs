<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

    <section class="container my-5">
    <h2 class="mb-4 fw-bold border-bottom pb-3">Roteiros Nacionais</h2>
    <div class="row">
        <% listaNacional.forEach(function(roteiro) { %>
            <div class="col-12 mb-4">
<div class="card card-roteiro shadow-sm border-0 mb-4">
    <div class="row g-0">
        <div class="col-md-5 h-100">
            <img src="/imgs/<%= roteiro.img %>" alt="<%= roteiro.nome %>">
        </div>
        
        <div class="col-md-7">
            <div class="card-body">
                <div>
                    <h3 class="fw-bold"><%= roteiro.nome %> - 3 Dias</h3>
                    <p class="text-muted mb-2"><%= roteiro.local %></p>
                    
                    <div class="roteiro-dias">
                        <p class="mb-1"><strong>Dia 1:</strong> <%= roteiro.dia1 %></p>
                        <p class="mb-1"><strong>Dia 2:</strong> <%= roteiro.dia2 %></p>
                        <p class="mb-1"><strong>Dia 3:</strong> <%= roteiro.dia3 %></p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<% }) %>
</div>
</section>

<section class="container my-5">
    <h2 class="mb-4 fw-bold border-bottom pb-3">Roteiros Internacionais</h2>
    <div class="row">
        <% listaInternacional.forEach(function(roteiro) { %>
            <div class="col-12 mb-4">
<div class="card card-roteiro shadow-sm border-0 mb-4">
    <div class="row g-0">
        <div class="col-md-5">
            <img src="/imgs/<%= roteiro.img %>" alt="<%= roteiro.nome %>">
        </div>
        
        <div class="col-md-7">
            <div class="card-body">
                <div>
                    <h3 class="fw-bold"><%= roteiro.nome %> - 3 Dias</h3>
                    <p class="text-muted mb-2"><%= roteiro.local %></p>
                    
                    <div class="roteiro-dias">
                        <p class="mb-1"><strong>Dia 1:</strong> <%= roteiro.dia1 %></p>
                        <p class="mb-1"><strong>Dia 2:</strong> <%= roteiro.dia2 %></p>
                        <p class="mb-1"><strong>Dia 3:</strong> <%= roteiro.dia3 %></p>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<% }) %>
</div>
</section>

<%- include ('partials/footer.ejs') %>